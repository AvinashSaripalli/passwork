# Docker Compose secrets — copy to .env and fill in real values
# Generate JWT secrets with: openssl rand -base64 48

DB_PASSWORD=change-me-to-a-long-random-password
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret

# Must EXACTLY match the origin users visit (CORS is strict)
CLIENT_URL=https://your-domain.com

# Gmail for invitation emails
MAIL_USER=yourname@gmail.com
MAIL_PASS=your-16-char-gmail-app-password

# Set to "true" only when the API runs behind a trusted reverse proxy
TRUST_PROXY=true