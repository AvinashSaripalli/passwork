{
  "manifest_version": 3,
  "name": "Vaultix",
  "version": "1.0.0",
  "description": "Quick access to your Vaultix password vault.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Vaultix"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://knbitrix.duckdns.org/*",
    "http://localhost:5173/*",
    "http://localhost:4173/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "vaultix@karnsphere.com",
      "strict_min_version": "113.0"
    }
  }
}
